# Clé de signature des sessions du back-office (obligatoire).
# Générer avec : openssl rand -hex 32
PAYLOAD_SECRET=

# Base de données.
# - Local : SQLite (fichier créé au premier lancement).
# - Production : chaîne de connexion Postgres (postgres://...).
DATABASE_URI=file:./payload.db
# Connexions simultanées à Postgres par processus (3 par défaut). Mettre 1 sur une base
# limitée à 5 connexions (offre « dev » de Clever Cloud, pour une démonstration).
# DATABASE_POOL_MAX=1

# URL publique officielle du site (sans « / » final). Nom de domaine à confirmer
# par TeleDok. Sous toute autre adresse (ex. *.cleverapps.io), le site interdit
# son indexation ; les autres domaines déclarés y sont redirigés.
NEXT_PUBLIC_SITE_URL=http://localhost:3085

# Stockage des fichiers envoyés depuis le BO (PDF des publications, visuels).
# Laisser vide en local : les fichiers vont dans ./media.
# En production : bucket compatible S3 (Clever Cloud Cellar).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mails envoyés via Resend : notifications des formulaires du site
# (candidature médecin, contact) et e-mails du back-office (invitation d'un
# compte, mot de passe oublié). Sans clé, aucun e-mail ne part : en local, le
# message est écrit dans la console ; en production, le formulaire signale un
# échec d'envoi. Le domaine de l'expéditeur doit être vérifié dans Resend.
RESEND_API_KEY=
EMAIL_FROM="TeleDok <noreply@teledok.fr>"
# Destinataires internes des notifications — adresses à fournir par TeleDok.
CANDIDATURES_EMAIL=
CONTACT_EMAIL=

# Captcha Cloudflare Turnstile devant le back-office (/BO). Actif seulement si
# les deux clés sont renseignées ; le widget doit autoriser le domaine du site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
